rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'rengifobastoco@gmail.com' ||
        request.auth.token.email == 'johnfrengifob@gmail.com' ||
        request.auth.token.email == 'legadobarber2026@gmail.com' ||
        request.auth.token.email == 'gerenciaorbit@gmail.com' ||
        (request.auth.token.email_verified == true && (
          request.auth.token.email == 'rengifobastoco@gmail.com' ||
          request.auth.token.email == 'johnfrengifob@gmail.com' ||
          request.auth.token.email == 'legadobarber2026@gmail.com' ||
          request.auth.token.email == 'gerenciaorbit@gmail.com'
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Colección de Usuarios (Coaches y Coachees)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Colección de Prospectos CRM
    match /prospects/{prospectId} {
      allow read, write: if true;
    }

    // Colección de Sesiones Individuales
    match /sessions/{sessionId} {
      allow read, write: if true;
    }

    // Bitácoras Reflexivas y Somáticas de Coachees
    match /formSubmissions/{submissionId} {
      allow read, write: if true;
    }

    // Auditorías Post-Sesión de Coaching (Coach ICF)
    match /postSessionForms/{formId} {
      allow read, write: if true;
    }

    // Inscripciones a Eventos y Talleres
    match /eventRegistrations/{regId} {
      allow read, write: if true;
    }

    // Cronograma Oficial de Eventos y Talleres Quincenales
    match /cronogramaEvents/{eventId} {
      allow read, write: if true;
    }

    // Experiencias Ontológicas
    match /experiences/{experienceId} {
      allow read, write: if true;
    }

    // Validaciones de Pago Bre-B Nu
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // 1. Talleres (Registro General & Acuerdos de Participantes)
    match /tallerRegistros/{tallerRegistroId} {
      allow read, write: if true;
    }

    // 2. Sesiones Individuales (Acuerdo Co-creativo de Trabajo)
    match /sesionIndividualAcuerdos/{acuerdoId} {
      allow read, write: if true;
    }

    // 3. Bitácora de Sesiones B2B
    match /bitacorasSesionesB2B/{b2bId} {
      allow read, write: if true;
    }

    // 4. Bitácora de Talleres
    match /bitacorasTalleres/{tallerId} {
      allow read, write: if true;
    }

    // Configuración viva de Pares Google Forms & Sheets
    match /formsSheetsIntegrations/{integrationId} {
      allow read, write: if true;
    }

    // Módulos y Sesiones Curriculares del Programa Ontológico
    match /programNodes/{nodeId} {
      allow read, write: if true;
    }

    // Configuración de Niveles (Nivel I, Nivel II, Nivel III)
    match /levelConfigs/{levelId} {
      allow read, write: if true;
    }

    // Documentos Google Workspace vinculados
    match /workspaceDocuments/{docId} {
      allow read, write: if true;
    }

    // Colección de Admins
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Documento de verificación de conexión y auditoría
    match /test/{docId} {
      allow read, write: if true;
    }

    match /system/{docId} {
      allow read, write: if true;
    }
  }
}
