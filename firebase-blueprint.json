        "meetLink": {
          "type": "string",
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "enum": ["scheduled", "completed", "cancelled"]
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "isPaid": {
          "type": "boolean"
        },
        "durationMinutes": {
          "type": "number"
        }
      },
      "required": ["id", "clientId", "status", "date"]
    },
    "FormSubmission": {
