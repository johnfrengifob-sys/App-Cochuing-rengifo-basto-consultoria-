  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Colección de participantes y coaches del sistema"
    },
    "/prospects/{prospectId}": {
      "schema": "Prospect",
      "description": "Colección de prospectos del CRM y conversatorios"
    },
    "/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Sesiones individuales de coaching ontológico"
    },
    "/formSubmissions/{submissionId}": {
      "schema": "FormSubmission",
      "description": "Cuadernos y reflexiones previas de los participantes"
    },
    "/postSessionForms/{formId}": {
      "schema": "PostSessionForm",
      "description": "Auditorías ICF y evaluaciones del coach"
    },
    "/eventRegistrations/{regId}": {
      "schema": "EventRegistration",
      "description": "Tickets y pre-inscripciones de eventos"
    },
    "/cronogramaEvents/{eventId}": {
      "schema": "CronogramaEvent",
      "description": "Eventos públicos y conversatorios quincenales"
    },
    "/experiences/{experienceId}": {
      "schema": "OntologicalExperience",
      "description": "Constructor visual de experiencias (Talleres, Sesiones 1 a 1, Retiros, Círculos)"
    },
    "/payments/{paymentId}": {
      "schema": "PaymentValidation",
      "description": "Comprobantes y verificaciones de pago Bre-B Nu"
    },
    "/tallerRegistros/{tallerRegistroId}": {
      "schema": "TallerRegistro",
      "description": "Acuerdos y registros de participantes de talleres en Google Forms/Sheets"
    },
    "/sesionIndividualAcuerdos/{acuerdoId}": {
      "schema": "SesionIndividualAcuerdo",
      "description": "Acuerdos co-creativos individuales diligenciados en Google Sheets"
    },
    "/bitacorasSesionesB2B/{b2bId}": {
      "schema": "BitacoraSesionB2B",
      "description": "Bitácoras reflexivas de sesiones directivas B2B"
    },
    "/bitacorasTalleres/{tallerId}": {
      "schema": "BitacoraTaller",
      "description": "Bitácoras y descubrimientos post-talleres ontológicos"
    },
    "/formsSheetsIntegrations/{integrationId}": {
      "schema": "FormsSheetsIntegration",
      "description": "Configuración viva de enlaces y sincronización de Google Forms & Sheets"
    }
  }
}
