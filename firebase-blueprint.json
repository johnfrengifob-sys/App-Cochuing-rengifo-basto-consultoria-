{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil de usuario del sistema (Coach o Participante)",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["coach", "client"]
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 500
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "status": {
          "type": "string",
          "enum": ["active", "waiting", "inactive"]
        },
        "programProgress": {
          "type": "number"
        },
        "programStep": {
          "type": "number"
        },
        "company": {
          "type": "string",
          "maxLength": 120
        },
        "primaryBreakdown": {
          "type": "string",
          "maxLength": 255
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Prospect": {
      "title": "Prospect",
      "description": "Prospecto en el pipeline CRM derivado de conversatorios o Make.com",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "whatsapp": {
          "type": "string",
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": ["matriz_enviada", "sesion_20min_agendada", "convertido", "descartado"]
        },
        "origin": {
          "type": "string",
          "maxLength": 150
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["id", "name", "whatsapp", "status", "origin"]
    },
    "Session": {
      "title": "Session",
      "description": "Sesión quincenal de coaching ontológico del programa de 12 semanas",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "clientId": {
          "type": "string",
          "maxLength": 128
        },
        "sessionNumber": {
          "type": "number"
